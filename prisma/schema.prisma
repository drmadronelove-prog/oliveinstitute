// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  INSTRUCTOR
  LEARNER
}

/// Which audience a course is sold to.
enum Track {
  CLINICIAN
  PUBLIC
}

/// Storefront visibility. Only PUBLISHED courses are sellable; ARCHIVED
/// courses stay readable for people who already own them.
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
  PDF
  QUIZ
}

/// How an enrollment came to exist.
enum EnrollmentSource {
  PURCHASE
  COMP
  BUNDLE
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

/// Attachment kind for a lesson resource (handout, external link, extra video).
enum MaterialType {
  PDF
  LINK
  VIDEO
}

model User {
  id              String    @id @default(cuid())
  name            String
  email           String    @unique
  passwordHash    String
  role            Role
  emailVerifiedAt DateTime?
  /// When the account holder ticked the terms and privacy boxes at sign-up.
  /// Null for accounts an admin created before they set their own password.
  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  coursesTaught           Course[]                 @relation("InstructorCourses")
  enrollments             Enrollment[]
  purchases               Purchase[]
  lessonProgress          LessonProgress[]
  uploadedResources       LessonResource[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
}

/// A single-use password reset grant. Only the SHA-256 hash of the token is
/// stored, so a leaked database row cannot be replayed as a reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Same shape as PasswordResetToken, for confirming an email address.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// One row per rate-limited attempt. Counting rows inside a time window is
/// enough at this scale and survives a restart, unlike an in-memory counter.
model RateLimitHit {
  id        String   @id @default(cuid())
  /// What is being limited, e.g. "register:ip" or "password-reset:email".
  scope     String
  /// The identity being limited: an IP address or a lowercased email.
  key       String
  createdAt DateTime @default(now())

  @@index([scope, key, createdAt])
  @@map("rate_limit_hits")
}

model Course {
  id               String       @id @default(cuid())
  slug             String       @unique
  title            String
  subtitle         String       @default("")
  description      String       @default("")
  track            Track
  priceCents       Int
  stripePriceId    String?
  status           CourseStatus @default(DRAFT)
  coverImageKey    String?
  estimatedMinutes Int
  sortOrder        Int
  publishedAt      DateTime?
  instructorId     String
  instructor       User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  modules     Module[]
  enrollments Enrollment[]
  purchases   Purchase[]

  @@map("courses")
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId, sortOrder])
  @@map("modules")
}

model Lesson {
  id              String     @id @default(cuid())
  moduleId        String
  module          Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  slug            String
  sortOrder       Int
  type            LessonType
  /// Provider-side video identifier; null for non-video lessons.
  videoUid        String?
  /// Rendered lesson body, for TEXT lessons.
  body            String?
  transcript      String?
  durationSeconds Int
  /// Viewable without an entitlement, as the course's sample lesson.
  isFreePreview   Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  resources LessonResource[]
  progress  LessonProgress[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("lessons")
}

model LessonResource {
  id           String       @id @default(cuid())
  lessonId     String
  lesson       Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type         MaterialType
  title        String
  url          String
  uploadedById String
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now())

  @@index([lessonId])
  @@map("lesson_resources")
}

model Enrollment {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id])
  courseId            String
  course              Course           @relation(fields: [courseId], references: [id])
  source              EnrollmentSource
  purchaseId          String?
  purchase            Purchase?        @relation(fields: [purchaseId], references: [id])
  grantedAt           DateTime         @default(now())
  completedAt         DateTime?
  certificateIssuedAt DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Purchase {
  id                      String         @id @default(cuid())
  userId                  String
  user                    User           @relation(fields: [userId], references: [id])
  courseId                String
  course                  Course         @relation(fields: [courseId], references: [id])
  stripeCheckoutSessionId String         @unique
  stripePaymentIntentId   String?
  amountCents             Int
  currency                String         @default("usd")
  status                  PurchaseStatus
  createdAt               DateTime       @default(now())
  paidAt                  DateTime?
  refundedAt              DateTime?

  enrollments Enrollment[]

  @@index([userId])
  @@index([courseId])
  @@map("purchases")
}

model LessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id])
  lessonId            String
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt         DateTime?
  lastPositionSeconds Int       @default(0)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}
