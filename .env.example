DATABASE_URL="postgresql://postgres:postgres@localhost:5432/olive_institute?schema=public"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed admin — `npm run db:seed` creates exactly this one ADMIN account and
# fails loudly if either value is unset. There are no demo accounts.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrator"

# Email (dev mode logs instead of sending; set RESEND_API_KEY to send for real)
RESEND_API_KEY=""
EMAIL_FROM="Olive Institute <noreply@oliveinstitute.org>"

# Development and test only: writes a copy of every sent email to this
# directory so the e2e suite can follow real verification and reset links.
# NEVER set this in production — it leaves reset links on disk.
EMAIL_CAPTURE_DIR=""

# Public origin, used for canonical and Open Graph URLs. Falls back to
# NEXTAUTH_URL when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Cloudflare Stream (lesson video hosting). Every video is uploaded with
# requireSignedURLs, so playback always goes through a short-lived signed
# token minted server-side — see src/lib/video.ts and
# GET /api/stream/token/[videoUid]. Leave unset until a Stream-enabled
# account exists; players then say so instead of rendering a broken frame,
# and the admin upload UI is disabled.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_STREAM_TOKEN=""

# Stripe (one-time course purchases). Checkout won't start and the webhook
# will refuse everything until both are set — see README's "Payments"
# section for how the two routes use them.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# File storage (local disk for now)
UPLOADS_DIR="./uploads"
